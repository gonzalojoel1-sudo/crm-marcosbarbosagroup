# Dockerfile.crm-mb — Fase 0 (custom app crm_core baked)
#
# Bakes apps/crm_core into crm-mb:17 → produces crm-mb:18.
# crm-mb:17 was built originally from frappe_docker build pipeline.
#
# Usage:
#   docker build -f docker/Dockerfile.crm-mb -t crm-mb:18 .
#
# Rollback path: tag the previous image first
#   docker tag crm-mb:17 crm-mb:17-pre-crm-core
# and switch compose back to that tag.

FROM crm-mb:17

# crm_core — premium custom app (T1-T3 of plan Fase 0).
# OWNED by cliente (Marcos Barbosa Group, proprietary license).
COPY --chown=frappe:frappe apps/crm_core /home/frappe/frappe-bench/apps/crm_core

USER root

# Ensure writability in case base image tightened perms unexpectedly
RUN chmod -R u+rwX,g+rwX /home/frappe/frappe-bench/apps/crm_core && \
    chown -R frappe:frappe /home/frappe/frappe-bench/apps/crm_core

# Bench expects apps to be git repos for get-app / migrate paths.
# Initialize a local-only repo so `bench --site X install-app crm_core` succeeds.
RUN cd /home/frappe/frappe-bench/apps/crm_core && \
    git init -q . && \
    git config user.email "bot@crm-marcosbarbosagroup.com" && \
    git config user.name "crm-mb-bot" && \
    git config commit.gpgsign false && \
    git add -A && \
    git commit -q -m "crm_core: initial bake ($(date -u +%Y-%m-%dT%H:%M:%SZ))" || true

USER frappe

# Workdir canonical
WORKDIR /home/frappe/frappe-bench

# Sanity: app registered
RUN cd /home/frappe/frappe-bench && \
    grep -q "crm_core" sites/apps.txt || echo "crm_core" >> sites/apps.txt && \
    cat sites/apps.txt
