# Dockerfile.crm-mb — Fase 0 v19 (custom app crm_core baked with canonical layout)
#
# Bakes apps/crm_core into crm-mb:18 → produces crm-mb:19.
#
# Usage:
#   docker build -f docker/Dockerfile.crm-mb -t crm-mb:19 .
#
# Rollback path:
#   docker tag crm-mb:18 crm-mb:18-pre-crm-core
#   sed -i 's|crm-mb:19|crm-mb:18-pre-crm-core|' compose.yaml
#   docker compose up -d
#
# IMPORTANT:
#   - /home/frappe/frappe-bench/apps/ is NOT a volume (persists per image)
#   - /home/frappe/frappe-bench/sites and logs ARE volumes (overwritten by data)
#   - We bake crm_core into the image for availability; install-app at runtime.
#
# Layout (canonical Frappe v15):
#   apps/crm_core/
#     pyproject.toml         # name="crm_core"
#     crm_core/               # Python package
#       __init__.py
#       hooks.py
#       modules.txt           # "MbCRM"
#       mbcrm/                # submodule matching the module name
#         doctype/<X>/<X>.{json,py}
#
# Verified 2026-09-14:
#   bench get-app + install-app + migrate + ORM CRUD (Task) all green on crm-test.

FROM crm-mb:18

# crm_core — premium custom app (Marcos Barbosa Group, proprietary).
# IMPORTANT: rm -rf first; COPY does not remove existing files, and the
# base image (crm-mb:18) bakes an older flat layout that would conflict.
RUN rm -rf /home/frappe/frappe-bench/apps/crm_core
COPY --chown=frappe:frappe apps/crm_core /home/frappe/frappe-bench/apps/crm_core

USER root
RUN chmod -R u+rwX,g+rwX /home/frappe/frappe-bench/apps/crm_core && \
    chown -R frappe:frappe /home/frappe/frappe-bench/apps/crm_core

# Install crm_core package into the bench venv so `import crm_core` resolves.
# Frappe v15 uses uv for sys.path resolution; install editable.
RUN cd /home/frappe/frappe-bench/apps/crm_core && \
    pip install --quiet -e . 2>&1 | tail -3 && \
    rm -rf /home/frappe/frappe-bench/apps/crm_core.egg-info /home/frappe/frappe-bench/apps/crm_core/crm_core/__pycache__ 2>/dev/null && \
    python3 -c "import crm_core.mbcrm.doctype.task.task as m; print('crm_core.mbcrm.doctype.task.task OK', m.Task)"

USER frappe
WORKDIR /home/frappe/frappe-bench
