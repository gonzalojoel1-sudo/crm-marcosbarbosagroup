# Dockerfile.crm-mb — Fase 0 (custom app crm_core baked)
#
# Bakes apps/crm_core into crm-mb:17 → produces crm-mb:18.
#
# Usage:
#   docker build -f docker/Dockerfile.crm-mb -t crm-mb:18 .
#
# Rollback path:
#   docker tag crm-mb:17 crm-mb:17-pre-crm-core
#   sed -i 's|crm-mb:18|crm-mb:17-pre-crm-core|' compose.yaml
#   docker compose up -d
#
# IMPORTANT:
#   - /home/frappe/frappe-bench/apps/ is NOT a volume (persists per image)
#   - /home/frappe/frappe-bench/sites and logs ARE volumes (overwritten by data)
#   - We bake crm_core into the image for availability; install-app at runtime.

FROM crm-mb:17

# crm_core — premium custom app (T1-T3 of plan Fase 0).
# Owned by cliente (Marcos Barbosa Group, proprietary).
COPY --chown=frappe:frappe apps/crm_core /home/frappe/frappe-bench/apps/crm_core

USER root
RUN chmod -R u+rwX,g+rwX /home/frappe/frappe-bench/apps/crm_core && \
    chown -R frappe:frappe /home/frappe/frappe-bench/apps/crm_core

# NOTE: We deliberately do NOT init a git repo here. Frappe v15 has bugs
# treating arbitrary git repos of in-tree apps as upstream Github. Instead,
# `bench init-from-image.sh` (script injected via ENTRYPOINT hook, NOT here) or
# the deploy step itself manages the git init at first run.
# If your team prefers git-init-baked, you may add it back; we observed
# PermissionError on rollback paths.

USER frappe
WORKDIR /home/frappe/frappe-bench
