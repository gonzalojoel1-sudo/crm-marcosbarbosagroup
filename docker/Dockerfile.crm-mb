# Dockerfile.crm-mb — crm_core baked into crm-mb:19 → produces crm-mb:20
#
# Canonical Frappe v15 app registration (mirrors how frappe.pth / crm.pth work):
#   <venv>/lib/python3.11/site-packages/<app>.pth  contains  <bench>/apps/<app>
#
# Layout (identical to apps/crm/crm/):
#   apps/crm_core/
#     pyproject.toml            # flit backend (Frappe canonical)
#     tests/
#     crm_core/                 # the Python package
#       __init__.py
#       hooks.py
#       modules.txt             # "MbCRM"
#       config/desktop.py
#       mbcrm/                  # submodule matching the module name
#         __init__.py
#         doctype/<X>/{X.json,X.py,__init__.py}

FROM crm-mb:19

RUN rm -rf /home/frappe/frappe-bench/apps/crm_core
COPY --chown=frappe:frappe apps/crm_core /home/frappe/frappe-bench/apps/crm_core

USER root

# Remove any stale editable-install artifacts from earlier attempts.
RUN rm -rf \
      /home/frappe/frappe-bench/env/lib/python3.11/site-packages/__editable__.crm_core* \
      /home/frappe/frappe-bench/env/lib/python3.11/site-packages/crm_core-*.dist-info \
      /home/frappe/frappe-bench/apps/crm_core.egg-info \
      /home/frappe/frappe-bench/apps/crm_core/crm_core.egg-info

# Register the app the same way frappe.pth and crm.pth do: a .pth in the
# bench venv site-packages containing the app's PARENT directory.
RUN printf '/home/frappe/frappe-bench/apps/crm_core\n' \
      > /home/frappe/frappe-bench/env/lib/python3.11/site-packages/crm_core.pth && \
    chown -R frappe:frappe \
      /home/frappe/frappe-bench/apps/crm_core \
      /home/frappe/frappe-bench/env/lib/python3.11/site-packages/crm_core.pth

# Smoke test with the bench venv python. Fails the build if the app is not
# importable — never ship a broken image.
RUN /home/frappe/frappe-bench/env/bin/python -c \
    "import crm_core, crm_core.mbcrm.doctype.task.task as m; print('crm_core OK:', crm_core.__file__, m.Task)"

USER frappe
WORKDIR /home/frappe/frappe-bench
